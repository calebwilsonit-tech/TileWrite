{
  "name": "@tilewright/hub-server",
  "version": "0.0.1",
  "private": true,
  "description": "The Tilewright Asset Hub: a small self-hostable server for sharing asset packs",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "tilewright-hub": "./dist/hub.mjs"
  },
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/hub.mjs",
    "start": "node dist/hub.mjs"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
