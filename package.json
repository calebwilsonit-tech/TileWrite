{
  "name": "tilewright",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "Tilewright - a no-code 2D isometric game engine",
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/plugins/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint packages samples e2e compat",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "playwright test e2e/live-assistant.spec.ts",
    "test:e2e": "npm run build -w @tilewright/editor && playwright test",
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev -w @tilewright/editor",
    "dist:win": "npm run build && npm run dist:win -w @tilewright/editor",
    "release": "node scripts/release.mjs",
    "installed": "node scripts/installed.mjs",
    "compat": "vitest run --config compat/vitest.config.ts",
    "nightgarden:build": "vitest run --config games/nightgarden/vitest.tools.config.ts games/nightgarden/tools/build",
    "nightgarden:check": "vitest run --config games/nightgarden/vitest.config.ts",
    "nightgarden:art": "playwright test --config games/nightgarden/playwright.art.config.ts --trace off",
    "nightgarden:e2e": "playwright test --config games/nightgarden/playwright.config.ts --trace off"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  }
}
